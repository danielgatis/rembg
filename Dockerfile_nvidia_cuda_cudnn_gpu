# CUDA 13 to match onnxruntime-gpu >= 1.27, which links against
# libcublasLt.so.13. Ubuntu 24.04 for Python 3.12; 22.04 ships 3.10, below the
# >=3.11 this project requires.
FROM nvidia/cuda:13.0.1-cudnn-devel-ubuntu24.04

WORKDIR /rembg

RUN apt-get update && apt-get install -y --no-install-recommends python3-pip python-is-python3 curl git && apt-get clean && rm -rf /var/lib/apt/lists/*

COPY . .

RUN python -m pip install ".[gpu,cli]" --break-system-packages
RUN rembg d bria-rmbg

EXPOSE 7000
ENTRYPOINT ["rembg"]
CMD ["--help"]
